{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-agent.local/contracts/task-execution-sse-event.schema.json",
  "title": "任务执行时间线 SSE 事件",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "sourceSequence", "occurredAt", "type", "payload"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(SCHEDULER|AGENT):[0-9]+$"
    },
    "source": {
      "type": "string",
      "enum": ["SCHEDULER", "AGENT"]
    },
    "sourceSequence": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  }
}
