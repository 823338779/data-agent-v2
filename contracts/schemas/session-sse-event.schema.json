{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-agent.local/contracts/session-sse-event.schema.json",
  "title": "会话 SSE 事件",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "conversationSessionId"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "execution_started",
        "user_message",
        "assistant_message",
        "assistant_delta",
        "stream_snapshot",
        "execution_phase_changed",
        "skill_activated",
        "context_compaction_started",
        "context_compaction_completed",
        "context_compaction_failed",
        "tool_call_started",
        "tool_call_completed",
        "tool_call_result",
        "tool_call_failed",
        "interaction_requested",
        "interaction_resolved",
        "user_confirmation_requested",
        "user_confirmation_resolved",
        "execution_completed",
        "execution_failed",
        "execution_cancelled",
        "error"
      ]
    },
    "conversationSessionId": { "type": "string", "minLength": 1 },
    "executionId": { "type": "string", "minLength": 1 },
    "executionEventSequence": { "type": "integer", "minimum": 1 },
    "executionAttemptNumber": { "type": "integer", "minimum": 0 },
    "modelInvocationSequence": { "type": "integer", "minimum": 0 },
    "outputDeltaSequence": { "type": "integer", "minimum": 0 },
    "delta": { "type": "string" },
    "answer": { "type": "string" },
    "checkpointedAt": { "type": ["string", "null"], "format": "date-time" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "phase": {
      "type": "string",
      "enum": [
        "RECEIVED",
        "PREPARING_CONTEXT",
        "CONNECTING_MODEL",
        "ANSWERING",
        "PERSISTING",
        "COMPLETED",
        "FAILED"
      ]
    },
    "payload": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": ["prompt", "input", "output", "toolInput", "toolOutput"]
        }
      }
    }
  },
  "oneOf": [
    {
      "title": "持久化生命周期事件",
      "properties": {
        "type": {
          "enum": [
            "execution_started",
            "user_message",
            "assistant_message",
            "skill_activated",
            "context_compaction_started",
            "context_compaction_completed",
            "context_compaction_failed",
            "tool_call_started",
            "tool_call_completed",
            "tool_call_result",
            "tool_call_failed",
            "interaction_requested",
            "interaction_resolved",
            "user_confirmation_requested",
            "user_confirmation_resolved",
            "execution_completed",
            "execution_failed",
            "execution_cancelled",
            "error"
          ]
        }
      },
      "required": ["executionEventSequence", "occurredAt"]
    },
    {
      "title": "回答增量",
      "x-v2-extension": true,
      "properties": { "type": { "const": "assistant_delta" } },
      "required": ["executionId", "executionAttemptNumber", "modelInvocationSequence", "outputDeltaSequence", "delta", "occurredAt"]
    },
    {
      "title": "流检查点快照",
      "x-v2-extension": true,
      "properties": { "type": { "const": "stream_snapshot" } },
      "required": [
        "executionId",
        "executionAttemptNumber",
        "modelInvocationSequence",
        "outputDeltaSequence",
        "answer",
        "checkpointedAt",
        "occurredAt"
      ]
    },
    {
      "title": "运行阶段变化",
      "x-v2-extension": true,
      "properties": { "type": { "const": "execution_phase_changed" } },
      "required": ["executionId", "executionEventSequence", "phase", "occurredAt"]
    }
  ],
  "x-frontend-projection": {
    "assistant_delta": "assistant.draft",
    "stream_snapshot": "execution.streamCheckpoint",
    "execution_phase_changed": "execution.timeline"
  },
  "x-sse-event-id": {
    "encoding": "e={sessionExecutionEventSequence};a={executionAttemptNumber};t={modelInvocationSequence};s={outputDeltaSequence}",
    "pattern": "^e=[0-9]+;a=[0-9]+;t=[0-9]+;s=[0-9]+$"
  },
  "x-sensitive-payload-fields-forbidden": [
    "prompt",
    "input",
    "output",
    "toolInput",
    "toolOutput"
  ]
}
