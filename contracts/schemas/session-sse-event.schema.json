{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-agent.local/contracts/session-sse-event.schema.json",
  "title": "会话详情 SSE 事件",
  "type": "object",
  "additionalProperties": true,
  "required": ["type", "conversationSessionId"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["session_snapshot", "execution_update", "message_update", "assistant_delta", "stream_snapshot", "workflow_snapshot", "workflow_update"]
    },
    "conversationSessionId": { "type": "string", "minLength": 1 },
    "session": {
      "type": "object",
      "required": ["projectId", "pinnedAt"],
      "properties": {
        "projectId": { "type": ["string", "null"] },
        "pinnedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "execution": { "type": "object" },
    "event": { "type": "object" },
    "messages": { "type": "array", "items": { "$ref": "#/$defs/message" } },
    "message": { "$ref": "#/$defs/message" },
    "executionId": { "type": "string", "minLength": 1 },
    "modelInvocationSequence": { "type": "integer", "minimum": 0 },
    "outputDeltaSequence": { "type": "integer", "minimum": 0 },
    "delta": { "type": "string" },
    "answer": { "type": "string" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "phase": { "type": "string" },
    "workflowId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "workflow": { "$ref": "#/$defs/workflowSnapshot" },
    "eventType": { "enum": ["workflow_started", "step_started", "step_progress", "step_succeeded", "step_failed", "step_retrying", "workflow_succeeded", "workflow_failed"] },
    "step": { "$ref": "#/$defs/workflowStep" },
    "status": { "$ref": "#/$defs/workflowStatus" },
    "task": { "anyOf": [{ "$ref": "#/$defs/workflowTaskRef" }, { "type": "null" }] },
    "detail": { "$ref": "#/$defs/workflowDetail" }
  },
  "oneOf": [
    {
      "title": "首次及重连权威会话快照",
      "properties": { "type": { "const": "session_snapshot" } },
      "required": ["session", "occurredAt"]
    },
    {
      "title": "可直接归约的执行更新",
      "properties": { "type": { "const": "execution_update" } },
      "required": ["execution", "event", "messages"]
    },
    {
      "title": "中心消息完整替换",
      "properties": { "type": { "const": "message_update" } },
      "required": ["message", "occurredAt"]
    },
    {
      "title": "回答增量",
      "properties": { "type": { "const": "assistant_delta" } },
      "required": ["executionId", "modelInvocationSequence", "outputDeltaSequence", "delta", "occurredAt"]
    },
    {
      "title": "流检查点快照",
      "properties": { "type": { "const": "stream_snapshot" } },
      "required": ["executionId", "modelInvocationSequence", "outputDeltaSequence", "phase", "answer", "occurredAt"]
    },
    {
      "title": "活动 Workflow 快照",
      "properties": { "type": { "const": "workflow_snapshot" } },
      "required": ["executionId", "workflow", "occurredAt"]
    },
    {
      "title": "Workflow 步骤更新",
      "properties": { "type": { "const": "workflow_update" } },
      "required": ["executionId", "workflowId", "sequence", "eventType", "step", "status", "task", "detail", "occurredAt"]
    }
  ],
  "$defs": {
    "message": {
      "type": "object",
      "required": ["conversationMessageId", "executionId", "role", "author", "content", "version", "thinkingProcess", "artifacts", "uiBlocks", "createdAt"],
      "properties": {
        "conversationMessageId": { "type": "string" },
        "executionId": { "type": ["string", "null"] },
        "role": { "enum": ["user", "assistant", "system"] },
        "author": { "type": "string" },
        "content": { "type": "string" },
        "version": { "type": "integer", "minimum": 0 },
        "thinkingProcess": { "type": "array", "items": { "$ref": "#/$defs/processItem" } },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
        "uiBlocks": { "type": "array", "items": { "$ref": "#/$defs/uiBlock" } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "artifactType", "displayName", "mediaType", "sizeBytes", "sha256", "pageOrSheetCount", "downloadUrl"],
      "properties": {
        "artifactId": { "type": "string" },
        "artifactType": { "enum": ["DOCX", "PPTX", "XLSX"] },
        "displayName": { "type": "string" },
        "mediaType": { "type": "string" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "pageOrSheetCount": { "type": ["integer", "null"], "minimum": 1 },
        "downloadUrl": { "type": "string", "pattern": "^/api/v1/agent-sessions/[^/]+/artifacts/[^/]+/content$" }
      }
    },
    "uiBlock": {
      "oneOf": [
        { "$ref": "#/$defs/artifactCard" },
        { "$ref": "#/$defs/gitChangeCard" }
      ]
    },
    "artifactCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "type", "schemaVersion", "variant", "payload", "displayOrder"],
      "properties": {
        "blockId": { "type": "string" },
        "type": { "const": "artifact-card" },
        "schemaVersion": { "const": 1 },
        "variant": { "type": "string" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifactId"],
          "properties": { "artifactId": { "type": "string" } }
        },
        "displayOrder": { "type": "integer", "minimum": 0 }
      }
    },
    "gitChangeCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "type", "schemaVersion", "variant", "payload", "displayOrder"],
      "properties": {
        "blockId": { "type": "string" },
        "type": { "const": "git-change-card" },
        "schemaVersion": { "const": 1 },
        "variant": { "type": "string" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["changeId", "sessionId"],
          "properties": { "changeId": { "type": "string", "minLength": 1 }, "sessionId": { "type": "string", "minLength": 1 } }
        },
        "displayOrder": { "type": "integer", "minimum": 0 }
      }
    },
    "processItem": {
      "oneOf": [
        { "$ref": "#/$defs/thinkingItem" },
        { "$ref": "#/$defs/toolItem" }
      ]
    },
    "processCommon": {
      "type": "object",
      "required": ["processItemId", "sequence", "type", "status", "createdAt", "startedAt", "completedAt", "durationMillis", "schemaVersion"],
      "properties": {
        "processItemId": { "type": "string", "format": "uuid" },
        "sequence": { "type": "integer", "minimum": 1 },
        "type": { "enum": ["THINKING", "TOOL"] },
        "status": { "enum": ["PREPARED", "RUNNING", "SUCCEEDED", "FAILED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "startedAt": { "type": ["string", "null"], "format": "date-time" },
        "completedAt": { "type": ["string", "null"], "format": "date-time" },
        "durationMillis": { "type": ["integer", "null"], "minimum": 0 },
        "schemaVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "thinkingItem": {
      "allOf": [
        { "$ref": "#/$defs/processCommon" },
        {
          "type": "object",
          "required": ["content", "contentTruncated", "originalContentSizeBytes", "contentSha256", "modelInvocationSequence", "modelProvider", "modelName"],
          "properties": {
            "type": { "const": "THINKING" },
            "content": { "type": "string" },
            "contentTruncated": { "type": "boolean" },
            "originalContentSizeBytes": { "type": "integer", "minimum": 0 },
            "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "modelInvocationSequence": { "type": "integer", "minimum": 1 },
            "modelProvider": { "type": "string" },
            "modelName": { "type": "string" }
          }
        }
      ]
    },
    "toolItem": {
      "allOf": [
        { "$ref": "#/$defs/processCommon" },
        {
          "type": "object",
          "required": ["toolName", "toolCallId", "modelInvocationSequence", "input", "output", "errorCode", "errorMessage"],
          "properties": {
            "type": { "const": "TOOL" },
            "toolName": { "type": "string" },
            "toolCallId": { "type": "string" },
            "modelInvocationSequence": { "type": "integer", "minimum": 1 },
            "input": { "$ref": "#/$defs/boundedPayload" },
            "output": { "anyOf": [{ "$ref": "#/$defs/boundedPayload" }, { "type": "null" }] },
            "errorCode": { "type": ["string", "null"] },
            "errorMessage": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "boundedPayload": {
      "type": "object",
      "required": ["value", "preview", "truncated", "originalSizeBytes", "sha256", "contentType"],
      "properties": {
        "value": {},
        "preview": { "type": ["string", "null"] },
        "truncated": { "type": "boolean" },
        "originalSizeBytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "contentType": { "type": "string" }
      }
    },
    "workflowStatus": {
      "enum": ["running", "succeeded", "failed", "cancelled", "timed_out"]
    },
    "workflowStep": {
      "enum": ["discover_semantic_resources", "build_query_plan", "validate_query_plan", "generate_sql", "validate_sql", "explain_sql", "execute_query", "verify_results", "analyze_results", "finalize_response"]
    },
    "workflowTaskRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "purpose", "index", "total"],
      "properties": {
        "taskId": { "type": "string" },
        "purpose": { "type": "string" },
        "index": { "type": "integer", "minimum": 1 },
        "total": { "type": "integer", "minimum": 1 }
      }
    },
    "workflowTaskSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "currentStep", "sql", "returnedRows", "truncated", "attempt", "message"],
      "properties": {
        "task": { "$ref": "#/$defs/workflowTaskRef" },
        "currentStep": { "$ref": "#/$defs/workflowStep" },
        "sql": { "type": ["string", "null"] },
        "returnedRows": { "type": ["integer", "null"], "minimum": 0 },
        "truncated": { "type": ["boolean", "null"] },
        "attempt": { "type": ["integer", "null"], "minimum": 1 },
        "message": { "type": ["string", "null"] }
      }
    },
    "workflowSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowId", "executionId", "latestSequence", "status", "currentStep", "tasks", "startedAt", "updatedAt"],
      "properties": {
        "workflowId": { "type": "string" },
        "executionId": { "type": "string" },
        "latestSequence": { "type": "integer", "minimum": 0 },
        "status": { "$ref": "#/$defs/workflowStatus" },
        "currentStep": { "$ref": "#/$defs/workflowStep" },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/workflowTaskSnapshot" } },
        "startedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "workflowDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semanticResourceNames", "sql", "returnedRows", "truncated", "attempt", "maxAttempts", "elapsedMillis", "message", "failureCode"],
      "properties": {
        "semanticResourceNames": { "type": "array", "items": { "type": "string" } },
        "sql": { "type": ["string", "null"] },
        "returnedRows": { "type": ["integer", "null"], "minimum": 0 },
        "truncated": { "type": ["boolean", "null"] },
        "attempt": { "type": ["integer", "null"], "minimum": 1 },
        "maxAttempts": { "type": ["integer", "null"], "minimum": 1 },
        "elapsedMillis": { "type": ["integer", "null"], "minimum": 0 },
        "message": { "type": ["string", "null"] },
        "failureCode": { "type": ["string", "null"] }
      }
    }
  },
  "x-frontend-projection": {
    "session_snapshot": "conversation.detail",
    "execution_update": "execution.timeline",
    "message_update": "conversation.message",
    "assistant_delta": "assistant.draft",
    "stream_snapshot": "execution.streamCheckpoint",
    "workflow_snapshot": "conversation.workflow",
    "workflow_update": "conversation.workflow"
  },
  "x-sensitive-payload-fields-forbidden": ["prompt", "toolInput", "toolOutput", "rows", "jdbcUrl", "password", "exception", "stackTrace"]
}
