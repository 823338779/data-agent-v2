{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "coverage",
    "entries",
    "executionFacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "executionFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messageSequence",
        "positionKind",
        "modelInvocationSequence"
      ],
      "properties": {
        "messageSequence": {
          "type": "integer",
          "minimum": 0
        },
        "positionKind": {
          "enum": [
            "MESSAGE_START",
            "INVOCATION_END",
            "MESSAGE_END"
          ]
        },
        "modelInvocationSequence": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromExclusive",
        "throughInclusive",
        "sourceDigest"
      ],
      "properties": {
        "fromExclusive": {
          "$ref": "#/$defs/cursor"
        },
        "throughInclusive": {
          "$ref": "#/$defs/cursor"
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text",
        "sources"
      ],
      "properties": {
        "kind": {
          "enum": [
            "GOAL",
            "CONSTRAINT",
            "EVENT",
            "FACT",
            "TODO",
            "ERROR",
            "RECOVERY"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/cursor"
          }
        }
      }
    }
  }
}
