<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.datagent</groupId>
        <artifactId>data-agent-v2-root</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>data-agent-v2</artifactId>
    <packaging>pom</packaging>

    <modules>
        <module>agent-domain</module>
        <module>agent-context-common</module>
        <module>agent-persistence</module>
        <module>agent-context-lsm</module>
        <module>agent-context-hierarchical</module>
        <module>agent-tool</module>
        <module>agent-skill</module>
        <module>agent-data-source</module>
        <module>agent-workflow</module>
        <module>agent-web</module>
        <module>agent-server</module>
        <module>agent-evals</module>
    </modules>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>1.6.3</version>
        </dependency>
    </dependencies>

    <properties>
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <starrocks-jdbc.version>1.1.1</starrocks-jdbc.version>
        <jsqlparser.version>5.3</jsqlparser.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <style>AOSP</style>
                        </googleJavaFormat>
                    </java>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
