{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datagent.local/schema/context-summary-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "coverage", "events"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "coverage": { "$ref": "#/$defs/coverage" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startTurnSequence", "endTurnSequence", "startMessageSequence", "endMessageSequence"],
      "properties": {
        "startTurnSequence": { "type": "integer", "minimum": 1 },
        "endTurnSequence": { "type": "integer", "minimum": 1 },
        "startMessageSequence": { "type": "integer", "minimum": 1 },
        "endMessageSequence": { "type": "integer", "minimum": 1 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title", "status", "confirmedFacts", "userPreferences", "workingHypotheses",
        "decisions", "rejectedApproaches", "toolFindings", "openQuestions", "nextSteps"
      ],
      "properties": {
        "title": { "$ref": "#/$defs/sourcedText" },
        "status": { "$ref": "#/$defs/sourcedStatus" },
        "confirmedFacts": { "$ref": "#/$defs/entries" },
        "userPreferences": { "$ref": "#/$defs/entries" },
        "workingHypotheses": { "$ref": "#/$defs/entries" },
        "decisions": { "$ref": "#/$defs/entries" },
        "rejectedApproaches": { "$ref": "#/$defs/entries" },
        "toolFindings": { "$ref": "#/$defs/entries" },
        "openQuestions": { "$ref": "#/$defs/entries" },
        "nextSteps": { "$ref": "#/$defs/entries" }
      },
      "anyOf": [
        { "properties": { "confirmedFacts": { "minItems": 1 } } },
        { "properties": { "userPreferences": { "minItems": 1 } } },
        { "properties": { "workingHypotheses": { "minItems": 1 } } },
        { "properties": { "decisions": { "minItems": 1 } } },
        { "properties": { "rejectedApproaches": { "minItems": 1 } } },
        { "properties": { "toolFindings": { "minItems": 1 } } },
        { "properties": { "openQuestions": { "minItems": 1 } } },
        { "properties": { "nextSteps": { "minItems": 1 } } }
      ]
    },
    "sourcedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "sourceRanges"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sourceRanges": { "$ref": "#/$defs/sourceRanges" }
      }
    },
    "sourcedStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "sourceRanges"],
      "properties": {
        "value": { "enum": ["ACTIVE", "COMPLETED", "BLOCKED", "UNKNOWN"] },
        "sourceRanges": { "$ref": "#/$defs/sourceRanges" }
      }
    },
    "entries": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/entry" }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "sourceRanges"],
      "properties": {
        "statement": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "sourceRanges": { "$ref": "#/$defs/sourceRanges" }
      }
    },
    "sourceRanges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/sourceRange" }
    },
    "sourceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startMessageSequence", "endMessageSequence"],
      "properties": {
        "startMessageSequence": { "type": "integer", "minimum": 1 },
        "endMessageSequence": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
